{
  "name": "tcam-memory-system",
  "version": "1.0.0",
  "description": "TCAM Memory System - Resilient 4-Layer Architecture",
  "main": "dist/index.js",
  "bin": {
    "anots": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist coverage",
    "import": "ts-node src/scripts/import-cli.ts"
  },
  "keywords": [
    "tcam",
    "memory-system",
    "langgraph",
    "qdrant",
    "mem0"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^0.3.21",
    "@langchain/core": "^0.3.80",
    "@langchain/langgraph": "^0.2.29",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@qdrant/js-client-rest": "^1.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fast-check": "^3.23.0",
    "inquirer": "^12.11.1",
    "js-yaml": "^4.1.0",
    "mem0ai": "^2.4.2",
    "ora": "^9.3.0",
    "puppeteer": "^24.40.0",
    "redis": "^4.7.1",
    "simple-git": "^3.33.0",
    "supertest": "^7.2.2",
    "uuid": "^13.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}

# ANOTS Unified Platform Configuration

# Deployment Mode (cli | mcp-server | standalone)
ANOTS_MODE=cli

# Data Directory
ANOTS_DATA_DIR=./data

# MCP Server Configuration
ANOTS_MCP_PORT=3100
ANOTS_MCP_AUTH_ENABLED=false
ANOTS_MCP_API_KEYS=

# REST API Configuration
ANOTS_API_PORT=3001
ANOTS_API_HOST=0.0.0.0
ANOTS_API_ENABLE_AXIOM=false
CORS_ORIGINS=*

# Gateway Configuration
ANOTS_GATEWAY_ENABLED=true

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:9b-instruct-q4_K_M

# Z.ai Cloud LLM Configuration (optional)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.1
ZAI_QUOTA_LIMIT=1000000
ZAI_QUOTA_RESET_INTERVAL_HOURS=24

# OpenRouter Cloud Alternative Configuration (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Redis Configuration (optional, for Active Stream L2)
REDIS_URL=redis://localhost:6379

# Qdrant Configuration (optional, for Hive Mind L3)
QDRANT_URL=http://localhost:6333

# Logging
LOG_LEVEL=info
